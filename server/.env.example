# MongoDB connection string — local, or a free Atlas cluster
MONGODB_URI=mongodb://localhost:27017/multichain-usdc

# Long random string used to sign session JWTs — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the frontend runs, for CORS
CLIENT_ORIGIN=http://localhost:3000

PORT=4000
